    // ── c = Code (LSP) ─────────────────────────────────────────────────────────────────

    {
      "key": "c",
      "name": "+Code",
      "type": "bindings",
      "bindings": [
        {
          "key": "a",
          "name": "Code Action",
          "type": "command",
          "command": "editor.action.quickFix"
        },
        {
          "key": "A",
