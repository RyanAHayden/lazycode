          "type": "command",
          "command": "workbench.view.scm"
        },
        {
          "key": "s",
          "name": "Git Status",
          "type": "command",
          "command": "workbench.view.scm"
        },
        {
          "key": "b",
          "name": "Blame Toggle",
          "type": "command",
          "command": "gitlens.toggleFileBlame"
        },
        {
          "key": "B",
          "name": "Browse on Remote",
