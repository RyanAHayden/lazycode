          "command": "gitlens.openFileOnRemote"
        },
        {
          "key": "d",
          "name": "Git Diff",
          "type": "command",
          "command": "git.openChange"
        },
        {
          "key": "l",
          "name": "File History",
          "type": "command",
          "command": "gitlens.showQuickFileHistory"
        },
        {
          "key": "L",
